      <aliases enabled='yes' />
      <column caption='&apos;Movie Share' datatype='real' name='[Calculation_0701541199798272]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [type]=&apos;MOVIE&apos; THEN [id] END) / COUNTD([id])' />
      </column>
      <column caption='Premium %' datatype='real' name='[Calculation_0701541200699393]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [imdb_score]&gt;=8 AND [tmdb_score]&gt;=8 THEN [id] END) / COUNTD([id])' />
      </column>
      <column caption='High Rated %' datatype='real' name='[Calculation_0701541202690050]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [imdb_score]&gt;=8 THEN [id] END) / COUNTD([id])' />
      </column>
      <column caption='Rating Category' datatype='string' name='[Calculation_0701541203124227]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [imdb_score]&gt;=7.5 THEN &quot;High&quot; ELSEIF [imdb_score]&gt;=6 THEN &quot;Medium&quot; ELSEIF [imdb_score]&gt;=0 THEN &quot;Low&quot; ELSE &quot;Not Rated&quot; END' />
      </column>
      <column caption='AVG([Imdb Score])' datatype='real' name='[Calculation_0701541203439620]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([imdb_score])' />
      </column>
      <column aggregation='Sum' caption='DECADE' datatype='integer' name='[Calculation_0701541271486469]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='INT([release_year]/10)*10' />
      </column>
      <column aggregation='None' caption='Imdb Score (bin)' datatype='integer' name='[Imdb Score (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='-1' formula='[imdb_score]' peg='0' size='0.5' />
      </column>
      <column aggregation='None' caption='Runtime (bin)' datatype='integer' name='[Runtime (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='1' formula='[runtime]' peg='0' size='10' />
      </column>
      <column aggregation='None' caption='Tmdb Score (bin)' datatype='integer' name='[Tmdb Score (bin)]' role='dimension' type='ordinal'>
        <calculation class='bin' decimals='-3' formula='[tmdb_score]' peg='0' size='0.596' />
